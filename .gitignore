# Hugo build output and runtime artifacts
public/
resources/
.hugo_build.lock

# Content generated by `make ingest` (one bundle per public note,
# rebuilt from $NOTES_PATH on demand). content/_index.md is hand-written
# and stays tracked.
content/*/

# Compiled ingest binary (we always run via `go run`, never check in builds)
/tools/ingest/ingest

# Editor / OS junk
.DS_Store

# Playwright session state (created by local browser tests)
.playwright-cli/

# Per-tool worktree / agent state
.claude/

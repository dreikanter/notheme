# Hugo build output and runtime artifacts
public/
resources/
.hugo_build.lock

# Content generated by `make ingest` (built from ~/Dropbox/Notes on demand)
content/notes/

# Compiled ingest binary (we always run via `go run`, never check in builds)
/tools/ingest/ingest

# Editor / OS junk
.DS_Store

# Playwright session state (created by local browser tests)
.playwright-cli/
